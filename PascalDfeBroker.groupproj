        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="DFe_UnitTests">
        <MSBuild Projects="tests\Unit\DFe.UnitTests.dproj"/>
    </Target>
    <Target Name="DFe_UnitTests:Clean">
        <MSBuild Projects="tests\Unit\DFe.UnitTests.dproj" Targets="Clean"/>
    </Target>
    <Target Name="DFe_UnitTests:Make">
        <MSBuild Projects="tests\Unit\DFe.UnitTests.dproj" Targets="Make"/>
