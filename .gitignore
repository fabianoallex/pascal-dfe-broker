# saidas de compilacao
build/
lib/
backup/
*.exe
*.o
*.a
*.ppu
*.rsj
*.compiled
*.dcu
Win32/
Win64/
linux/

# recurso .res gerado pelo IDE
*.res

# certificados digitais e configs locais (nunca versionar certificado real)
certs/*.pfx
certs/*.p12
certs/*.crt
certs/*.key
config/*.local.ini
config/*.local.json

# binario ELF (sem extensao) gerado por lazbuild em Linux no proprio diretorio
tests/Unit/fpc/DFeUnitTestsFpc

# arquivo de teste temporario gerado pela suite (ver DFe.CursorStoreArquivoTests)
dfe_cursor_teste.cursores*

# cache de package-links do lazbuild (especifico da maquina)
/packagefiles.xml

# arquivos de sessao/IDE
*.lps
*.local
*.identcache
*.stat
__history/
__recovery/

# saidas geradas pelo ACBr ao rodar o spike
tools/spike-sim/Docs/
tests/Integration/AcbrSim/Docs/

# resultado XML do DUnitX
dunitx-results.xml
tests/Integration/AcbrSim/tmp-amb-*/

# config local e estado de execucao do host console (pode ter senha; WAL do broker embutido)
hosts/console/dfe.ini
hosts/console/broker/
hosts/console/cursores.dat
hosts/servico/dfe.ini
hosts/servico/logs/
hosts/servico/broker/
hosts/servico/cursores.dat
hosts/console/logs/

# saidas do demo
tools/demo/*.exe

# XML gravados pelo consumidor Pascal (--salvar, pasta padrao xml-recebidos)
xml-recebidos/
